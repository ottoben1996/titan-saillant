{
  "name": "coach-ottman-laura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc -b --force",
    "size": "size-limit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@size-limit/file": "^13.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "size-limit": "^13.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "size-limit": [
    {
      "name": "paquet initial",
      "path": "dist/assets/index-*.js",
      "limit": "165 kB"
    },
    {
      "name": "styles",
      "path": "dist/assets/index-*.css",
      "limit": "22 kB"
    },
    {
      "name": "espace MUSTAPHA (chargé à l'ouverture seulement)",
      "path": "dist/assets/MustaphaApp-*.js",
      "limit": "16 kB"
    }
  ]
}
